{
   "compilerOptions": {
      "target": "ES2022",
      "lib": ["ES2022", "DOM", "DOM.Iterable"],
      "module": "ESNext",
      "moduleResolution": "bundler",
      "jsx": "react-jsx",
      "resolveJsonModule": true,
      "allowImportingTsExtensions": true,
      "verbatimModuleSyntax": true,
      "noEmit": true,
      "strict": true,
      "skipLibCheck": true,
      "types": ["node"]
   },
   "include": ["rspress.config.ts", "docs/**/*.ts", "docs/**/*.tsx"],
   "exclude": ["build", "node_modules"]
}
